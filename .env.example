# Copy this to .env and fill in real values. Never commit .env.

# Absolute path to your Obsidian vault on the server
VAULT_PATH=/home/<your-user>/vault

# Where the SQLite database lives (will be a Docker volume in Phase 4)
DB_PATH=/data/brain.db

# FastAPI port
PORT=8000

# Notion integration token (from notion.so/my-integrations)
NOTION_TOKEN=
NOTION_TASKS_DB=
NOTION_SCHEDULE_DB=

# --- Unified search (A1) ---
# Read-only GitHub token (scope: repo) for indexing your repos
GITHUB_TOKEN=
# Path to the synced claude-memory sessions/ directory on the server
MEMORY_SESSIONS_PATH=/home/<your-user>/.claude/memory/sessions

# --- DEV OVERRIDES (use these in your local .env while developing) ---
# VAULT_PATH=./tests/sample_vault
# DB_PATH=./data/brain.db
